rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and settings
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User non-destructive photo projects
      match /projects/{projectId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      // User custom presets and favorite filters
      match /presets/{presetId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public curated filter collections (read-only for all authenticated clients)
    match /public_filters/{filterId} {
      allow read: if true;
      allow write: if false; // Admin only via Firebase Admin SDK
    }

    // Default catch-all denies access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
